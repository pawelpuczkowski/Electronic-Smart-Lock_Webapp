@page
@model ZamekDoDrzwi.Pages.DashboardModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Kontroli Dostępu – Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet" />
    <link href="/css/navbar.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

</head>
<body>
    @await Html.PartialAsync("_LayoutNavbar")

    <main class="container py-5">
        <div class="row g-4">

            @* Szybki status *@
            <div class="col-md-6">
                <div class="card card-dark">
                    <div class="card-body">
                        <h5 class="card-title">Szybki status systemu</h5>
                        <p>Drzwi: <strong>@Model.StatusDrzwi</strong></p>
                        <p>Połączenie: <strong>@Model.StatusPolaczenia</strong></p>
                        <hr />
                        <p>RFID: <strong>@Model.StatusRFID</strong></p>
                        <p>GSM: <strong>@Model.StatusGSM</strong></p>
                        <p>Kamera: <strong>@Model.StatusKamera</strong></p>
                    </div>
                </div>
            </div>

            @* Logi zdarzeń *@
            <div class="col-md-6">
                <div class="card card-dark">
                    <div class="card-body">
                        <h5 class="card-title">Logi zdarzeń</h5>
                        <ul class="event-list mb-0" style="max-height: 280px; overflow:auto;">
                            @foreach (var log in Model.Logi)
                            {
                                <li>
                                    <small class="text-muted me-2">@log.Godzina</small>
                                    @log.Tresc
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            @* Generuj i wyślij kod *@
            <div class="col-md-6">
                <div class="card card-dark">
                    <div class="card-body">
                        <h5 class="card-title">Wygeneruj i wyślij kod dostępu</h5>

                        @if (TempData["KomunikatKod"] != null)
                        {
                            <div class="alert alert-info mb-3">
                                @TempData["KomunikatKod"]
                            </div>
                        }

                        <form method="post" asp-page-handler="WyslijKod">
                            <div class="mb-2">
                                <label for="telefon" class="form-label">Numer telefonu</label>
                                <input type="tel" name="telefon" id="telefon"
                                       class="form-control mb-2"
                                       placeholder="np. +48123456789" required />
                            </div>

                            <div class="mb-3">
                                <label for="czas" class="form-label">Czas ważności</label>
                                <input type="text" name="czas" id="czas"
                                       class="form-control"
                                       placeholder="Wybierz datę i godzinę" required />
                            </div>

                            <button type="submit" class="btn accent w-100">Wyślij kod SMS</button>
                        </form>
                    </div>
                </div>
            </div>

            @* Wykresy *@
            <div class="col-md-6">
                <div class="card card-dark">
                    <div class="card-body">
                        <h5 class="card-title">Stan urządzenia</h5>

                        <ul class="nav nav-tabs mb-3" id="chartTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#chart1" type="button" role="tab">Zdarzenia dziennie</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chart2" type="button" role="tab">Błędy</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chart3" type="button" role="tab">Typy komponentów</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chart4" type="button" role="tab">Zdjęcia dziennie</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chart5" type="button" role="tab">Typy zdarzeń</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#chart6" type="button" role="tab">Godziny aktywności</button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <div class="tab-pane fade show active" id="chart1" role="tabpanel">
                                <canvas id="chartZdarzenia"></canvas>
                            </div>
                            <div class="tab-pane fade" id="chart2" role="tabpanel">
                                <canvas id="chartBledy"></canvas>
                            </div>
                            <div class="tab-pane fade" id="chart3" role="tabpanel">
                                <canvas id="chartKomponenty"></canvas>
                            </div>
                            <div class="tab-pane fade" id="chart4" role="tabpanel">
                                <canvas id="chartZdjecia"></canvas>
                            </div>
                            <div class="tab-pane fade" id="chart5" role="tabpanel">
                                <canvas id="chartTypyZdarzen"></canvas>
                            </div>
                            <div class="tab-pane fade" id="chart6" role="tabpanel">
                                <canvas id="chartGodziny"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Ostatnie powiadomienia *@
            <div class="col-md-6">
                <div class="card card-dark">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-bell-fill me-2"></i> Ostatnie powiadomienia
                        </h5>

                        <ul id="dashNotifList" class="list-group list-group-flush" style="max-height: 280px; overflow:auto;">
                            <div class="text-center text-muted small py-3">Ładowanie...</div>
                        </ul>
                    </div>
                </div>
            </div>


            @* Podgląd kamery *@
            <div class="col-md-6">
                <div class="card card-dark">
                    <div class="card-body">
                        <h5 class="card-title">Podgląd kamery</h5>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var zdj in Model.OstatnieZdjecia)
                            {
                                <img src="@zdj" class="thumb"
                                     onclick="powiekszZdjecie('@zdj')" />
                            }
                        </div>

                        <div id="lightbox" class="position-fixed top-0 start-0 w-100 h-100 justify-content-center align-items-center">
                            <img id="lightbox-img" src="" class="img-fluid rounded border border-light" />
                            <button onclick="zamknijLightbox()" class="btn btn-light position-absolute top-0 end-0 m-3 fs-3">&times;</button>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </main>

    <script>
        flatpickr("#czas", {
            enableTime: true,
            dateFormat: "Y-m-d H:i",
            time_24hr: true,
            minDate: "today"
        });
    </script>

    <script>
        const modelData = {
            labelList: @Html.Raw(Json.Serialize(Model.LabelList)),
            valueList: @Html.Raw(Json.Serialize(Model.ValueList)),
            bledyLabels: @Html.Raw(Json.Serialize(Model.BledyLabels)),
            bledyValues: @Html.Raw(Json.Serialize(Model.BledyValues)),
            komponentyLabels: @Html.Raw(Json.Serialize(Model.KomponentyLabels)),
            komponentyValues: @Html.Raw(Json.Serialize(Model.KomponentyValues)),
            zdjeciaLabels: @Html.Raw(Json.Serialize(Model.ZdjeciaLabels)),
            zdjeciaValues: @Html.Raw(Json.Serialize(Model.ZdjeciaValues)),
            typyLabels: @Html.Raw(Json.Serialize(Model.TypyLabels)),
            typyValues: @Html.Raw(Json.Serialize(Model.TypyValues)),
            godzinyLabels: @Html.Raw(Json.Serialize(Model.GodzinyLabels)),
            godzinyValues: @Html.Raw(Json.Serialize(Model.GodzinyValues))
        };
    </script>
    <script src="/js/dashboard.js"></script>
    <script src="/js/dashboard-notifications.js"></script>
</body>
</html>

