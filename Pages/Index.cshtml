@page
@model IndexModel
@{
    Layout = null;  
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Kontroli Dostępu</title>
   
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body>  
    <div class="login-box">
        @* Logo i nazwa systemu*@
        <div class="logo-text d-flex align-items-center justify-content-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                 viewBox="0 0 24 24" stroke-width="1.5" stroke="#0ff"
                 fill="none" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="11" width="14" height="10" rx="2" />
                <circle cx="12" cy="16" r="1" />
                <path d="M8 11v-4a4 4 0 0 1 8 0v4" />
            </svg>
            <span>Zamek do drzwi</span>
        </div>

        @* Formularz logowania *@
        <form method="post">

            @* Pole loginu lub adresu e-mail *@
            <div class="mb-3">
                <input asp-for="Login" class="form-control" placeholder="Login lub Email" />
                <span asp-validation-for="Login" class="text-danger small"></span>
            </div>

            @* Pole hasła *@
            <div class="mb-3">
                <input asp-for="Password" type="password" class="form-control" placeholder="Hasło" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            @* Przycisk logowania *@
            <button type="submit" class="btn btn-primary w-100">Zaloguj</button>

            @* Komunikat o błędzie (np. zły login lub hasło) *@
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error-message">@Model.ErrorMessage</div>
            }
        </form>

        @* Link do resetowania hasła *@
        <div class="text-center mt-3">
            <a href="/ResetujHaslo" class="text-info">Nie pamiętasz hasła?</a>
        </div>
    </div>
</body>
</html>
