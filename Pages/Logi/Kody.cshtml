@page
@model ZamekDoDrzwi.Pages.Logi.KodyModel
@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Kontroli Dostępu - Kody dostępu</title>  
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet" />
    <link href="/css/navbar.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body> 
    @await Html.PartialAsync("_LayoutNavbar")

    <div class="container py-5">

        @* Sekcja nagłówkowa *@
        <div class="card-dark p-4 mb-4">
            <div class="d-flex align-items-center">
                <i class="bi bi-shield-lock-fill me-2 fs-3" style="color: var(--accent);"></i>
                <h3 class="m-0 fw-semibold">Lista kodów dostępu</h3>
            </div>
            <p class="muted mt-2 mb-0">
                Przeglądaj, blokuj / odblokowuj lub usuwaj kody jednorazowe.
            </p>
        </div>

        @* Główna tabela kodów *@
        @if (Model.Kody.Any())
        {
            <div class="card-dark p-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 56px;">#</th>
                                <th>Numer telefonu</th>
                                <th>Kod logowania</th>
                                <th>Wygasa</th>
                                <th>Użyty</th>
                                <th class="text-center" style="width: 260px;">Akcja</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Kody.Count; i++)
                            {
                                var kod = Model.Kody[i];
                                <tr>
                                    @* Numeracja *@
                                    <td class="text-center">@(i + 1)</td>

                                    @* Dane kodu *@
                                    <td>@kod.PhoneNumber</td>
                                    <td class="fw-bold">@kod.LoginCode</td>
                                    <td>@kod.ValidUntil.ToString("yyyy-MM-dd HH:mm")</td>

                                    @* Czy kod został użyty *@
                                    <td>
                                        @if (kod.UsedLoginCode)
                                        {
                                            <span class="badge bg-secondary px-3 py-2">Tak</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-3 py-2">Nie</span>
                                        }
                                    </td>

                                    @* Sekcja akcji (blokuj / odblokuj / usuń) *@
                                    <td class="text-center">
                                        @if (kod.ValidUntil <= DateTime.Now)
                                        {
                                            @* Kod już wygasł *@
                                            <span class="muted">Wygasł</span>
                                        }
                                        else if (!kod.UsedLoginCode)
                                        {
                                            @* Kod aktywny -> można zablokować *@
                                            <form method="post" asp-page-handler="Zablokuj" asp-route-id="@kod.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm accent-outline me-1">
                                                    <i class="bi bi-lock-fill me-1"></i> Zablokuj
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            @* Kod użyty -> można odblokować *@
                                            <form method="post" asp-page-handler="Odblokuj" asp-route-id="@kod.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm accent me-1">
                                                    <i class="bi bi-unlock me-1"></i> Odblokuj
                                                </button>
                                            </form>
                                        }

                                        @* Usunięcie kodu *@
                                        <form method="post" asp-page-handler="Usun" asp-route-id="@kod.Id"
                                              class="d-inline"
                                              onsubmit="return confirm('Na pewno usunąć ten kod?');">
                                            <button class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash-fill me-1"></i> Usuń
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            @* Komunikat, gdy brak kodów w systemie *@
            <div class="alert alert-warning shadow-sm rounded-3">
                Brak aktywnych kodów dostępu.
            </div>
        }
    </div>
</body>
</html>
