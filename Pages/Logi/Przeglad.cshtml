@page
@model ZamekDoDrzwi.Pages.Logi.PrzegladModel
@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Kontroli Dostępu - Logi systemowe</title>    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet" />
    <link href="/css/navbar.css" rel="stylesheet" />

    <style>
        /* Pojedynczy wpis logu */
        .log-item {
            border-bottom: 1px solid #333;
            padding: 12px 16px;
            border-radius: 6px;
            transition: background 0.3s ease, transform 0.2s ease;
        }

            .log-item:hover {
                background-color: rgba(255, 255, 255, 0.04);
                transform: scale(1.01);
            }

        /* Log z błędem */
        .log-error {
            background-color: rgba(255, 70, 70, 0.12);
            border-left: 4px solid #ff4d4d;
        }

        /* Czas zdarzenia */
        .time {
            font-size: 0.9rem;
            color: #aaa;
        }

        /* Pasek wyszukiwania */
        .search-bar {
            background-color: #111;
            border: 1px solid #0ff;
            color: #0ff;
        }

            .search-bar:focus {
                box-shadow: 0 0 8px #0ff;
            }
    </style>
</head>

<body>
    @* Pasek nawigacji *@
    @Html.Partial("_LayoutNavbar")

    <main class="container py-5">
        <div class="card-dark p-4 shadow-sm">

            @* Nagłówek sekcji *@
            <h3 class="mb-3 text-info">
                <i class="bi bi-journal-text me-2"></i> Logi systemowe
            </h3>
            <p class="text-muted mb-4">
                Podgląd ostatnich 100 zdarzeń zapisanych w systemie.
            </p>

            @* Formularz wyszukiwania *@
            <form method="get" class="mb-3 d-flex gap-2">
                <input type="text"
                       name="Szukaj"
                       value="@Model.Szukaj"
                       placeholder="Wyszukaj w logach..."
                       class="form-control search-bar" />
                <button class="btn accent" type="submit">
                    <i class="bi bi-search"></i>
                </button>
            </form>

            @* Lista logów *@
            <div class="list-group list-group-flush">

                @if (Model.Logi.Any())
                {
                    foreach (var log in Model.Logi)
                    {
                        string kolor = log.Sukces ? "" : "log-error";

                        <div class="log-item @kolor">
                            <div class="d-flex justify-content-between align-items-center">

                                @* Treść zdarzenia *@
                                <div>
                                    @if (!log.Sukces)
                                    {
                                        <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                                    }
                                    @log.Szczegoly
                                </div>

                                @* Data / czas *@
                                <div class="time">
                                    <i class="bi bi-clock me-1"></i>
                                    @log.Czas.ToString("yyyy-MM-dd HH:mm:ss")
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                   @* Komunikat, gdy brak logów *@
                    <div class="text-muted text-center py-4">
                        Brak zapisanych logów w systemie.
                    </div>
                }
            </div>
        </div>
    </main>
</body>
</html>
