@page
@model ZamekDoDrzwi.Pages.Powiadomienia.ZdarzeniaModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Kontroli Dostępu - Zdarzenia do powiadomień</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet" />
    <link href="/css/navbar.css" rel="stylesheet" />
</head>

<body>
    @await Html.PartialAsync("_LayoutNavbar")

    <main class="container py-5">
        <div class="card-dark p-4 shadow-sm">

            @* Nagłówek sekcji *@
            <h3 class="mb-3">
                <i class="bi bi-bell-fill me-2 text-info"></i>
                Zdarzenia do powiadomień
            </h3>
            <p class="muted mb-4">
                Ustaw, które typy zdarzeń mają generować powiadomienia.
                <br />
                <small class="text-warning">
                    Uwaga: Kanał musi być włączony również globalnie w zakładce <b>Konfiguracja kanałów</b>.
                </small>
            </p>

            @* Komunikat po zapisie *@
            @if (!string.IsNullOrEmpty(Model.KomunikatZdarz))
            {
                <div class="alert alert-info mb-4 text-center shadow-sm">
                    <i class="bi bi-info-circle me-2"></i>@Model.KomunikatZdarz
                </div>
            }

            @* Formularz ustawień powiadomień *@
            <form method="post">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle text-center shadow-sm">
                        <thead>
                            <tr>
                                <th class="text-start ps-3">Zdarzenie</th>
                                <th>E-mail</th>
                                <th>Log</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (int i = 0; i < Model.Zdarzenia.Count; i++)
                            {
                                var zd = Model.Zdarzenia[i];
                                <tr>
                                    @* Nazwa zdarzenia *@
                                    <td class="text-start ps-3">
                                        @zd.EventLabel
                                        <input type="hidden" asp-for="@Model.Zdarzenia[i].EventType" />
                                    </td>

                                    @* Kanał e-mail *@
                                    <td>
                                        <div class="form-check d-flex justify-content-center mb-0">
                                            <input class="form-check-input" asp-for="@Model.Zdarzenia[i].EmailEnabled" />
                                        </div>
                                    </td>

                                    @* Kanał logów *@
                                    <td>
                                        <div class="form-check d-flex justify-content-center mb-0">
                                            <input class="form-check-input" asp-for="@Model.Zdarzenia[i].LogEnabled" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Przycisk zapisu *@
                <button type="submit" class="btn accent mt-3 px-4 shadow-sm">
                    <i class="bi bi-save-fill me-2"></i>Zapisz ustawienia
                </button>
            </form>
        </div>
    </main>
</body>
</html>
