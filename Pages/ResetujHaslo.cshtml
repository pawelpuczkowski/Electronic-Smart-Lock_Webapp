@page
@model ResetujHasloModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>System Kontroli Dostępu - Resetuj hasło</title>  
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body>    
    <div class="login-box">
     
        <div class="logo-text d-flex align-items-center justify-content-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="32" height="32"
                 stroke="#0ff" fill="none"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="11" width="14" height="10" rx="2" />
                <circle cx="12" cy="16" r="1" />
                <path d="M8 11v-4a4 4 0 0 1 8 0v4" />
            </svg>
            <span>Resetuj hasło</span>
        </div>

        @* Formularz wysyłki e-maila resetującego *@
        <form method="post">

            @* Pole adresu e-mail *@
            <div class="mb-3">
                <input asp-for="Email" class="form-control" placeholder="Wpisz swój e-mail" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            @* Przycisk wysyłki linku *@
            <button type="submit" class="btn btn-primary w-100">
                Wyślij link resetujący
            </button>

            @* Komunikat zwrotny z modelu (np. „Wysłano wiadomość” lub „Nie znaleziono konta”) *@
            @if (!string.IsNullOrEmpty(Model.InfoMessage))
            {
                <div class="error-message mt-3">@Model.InfoMessage</div>
            }
        </form>
    </div>
</body>
</html>
