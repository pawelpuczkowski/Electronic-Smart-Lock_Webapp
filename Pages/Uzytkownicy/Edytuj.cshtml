@page
@model ZamekDoDrzwi.Pages.Uzytkownicy.EdytujModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Kontroli Dostępu - Edytuj użytkownika</title>   
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/site.css" rel="stylesheet" />
</head>

<body>
   @* Główne okno formularza edycji użytkownika *@
    <div class="login-box">

        @* Tytuł formularza *@
        <div class="logo-text">Edytuj użytkownika</div>

        @* Formularz edycji *@
        <form method="post">

            @* Pole: Login użytkownika *@
            <div class="mb-3">
                <input asp-for="Login" class="form-control" placeholder="Login" />
            </div>

            @* Pole: E-mail użytkownika *@
            <div class="mb-3">
                <input asp-for="Email" class="form-control" placeholder="Email" />
            </div>

            @* Pole: Telefon użytkownika (opcjonalne) *@
            <div class="mb-3">
                <input asp-for="Telefon" class="form-control" placeholder="Telefon (opcjonalnie)" />
            </div>

            @* Pole: Rola użytkownika *@
            <div class="mb-3">
                <select asp-for="Rola" class="form-control">
                    <option value="admin">Admin</option>
                    <option value="user">Użytkownik</option>
                </select>
            </div>

            @* Przycisk: Zapisz zmiany *@
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-save me-1"></i> Zapisz zmiany
            </button>

            @* Komunikat błędu (jeśli coś poszło nie tak) *@
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error-message mt-3 text-center">@Model.ErrorMessage</div>
            }
        </form>

        @* Link powrotu do listy użytkowników *@
        <div class="text-center mt-3">
            <a href="/Uzytkownicy/Lista" class="text-info">
                ← Powrót do listy
            </a>
        </div>
    </div>
</body>
</html>
