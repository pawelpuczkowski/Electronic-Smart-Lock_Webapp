@page
@model ZamekDoDrzwi.Pages.Uzytkownicy.KartyModel
@{
    Layout = null; // Widok działa niezależnie od głównego layoutu
}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Kontroli Dostępu - Panel Administratora</title>    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet" />
    <link href="/css/navbar.css" rel="stylesheet" />

    <!-- (kalendarz dat ważności) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">  
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

<body>  
    @Html.Partial("_LayoutNavbar")

    <div class="container py-5">        >
        <div class="card-dark p-4 shadow-sm mb-4">
            <h3 class="mb-3">
                <i class="bi bi-credit-card-2-front me-2"></i> Dostępne karty RFID
            </h3>
            <p class="muted mb-0">
                Lista wszystkich zarejestrowanych kart RFID w systemie.
            </p>
        </div>

        <!-- Tabela z listą kart -->
        <div class="card-dark p-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-dark table-bordered text-center align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>UID</th>
                            <th>Opis</th>
                            <th>Użytkownik</th>
                            <th>Dodano</th>
                            <th>Ważna do</th>
                            <th>Status</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Pętla po wszystkich kartach RFID *@
                        @foreach (var karta in Model.DostepneKarty)
                        {
                            <tr>
                                @* Identyfikator karty *@
                                <td>@karta.Id</td>
                               
                                <td>@karta.UID</td>
                                
                                <td>@karta.Opis</td>

                                @* Login przypisanego użytkownika lub brak *@
                                <td>
                                    @if (!string.IsNullOrEmpty(karta.Login))
                                    {
                                        <span style="color: var(--accent);">@karta.Login</span>
                                    }
                                    else
                                    {
                                        <span class="muted">Brak</span>
                                    }
                                </td>

                               @* Data dodania *@
                                <td>@karta.DataDodania?.ToString("yyyy-MM-dd HH:mm")</td>

                                @* Data ważności (lub „bez limitu”) *@
                                <td>
                                    @if (karta.DataWaznosci.HasValue)
                                    {
                                        @karta.DataWaznosci.Value.ToString("yyyy-MM-dd")
                                    }
                                    else
                                    {
                                        <span class="muted">bez limitu</span>
                                    }
                                </td>

                                @* Status aktywności karty *@
                                <td>
                                    @if (karta.Aktywna)
                                    {
                                        <span class="badge bg-success">Aktywna</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Nieaktywna</span>
                                    }
                                </td>

                                @* Akcje administracyjne dla danej karty *@
                                <td>
                                    @* Jeśli karta przypisana do użytkownika – pokaż przycisk „Odepnij” *@
                                    @if (!string.IsNullOrEmpty(karta.Login))
                                    {
                                        <form method="post" asp-page-handler="Odepnij" asp-route-id="@karta.Id" class="d-inline"
                                              onsubmit="return confirm('Czy na pewno chcesz odpiąć tę kartę od użytkownika?');">
                                            <button type="submit" class="btn btn-sm btn-warning me-1">
                                                Odepnij
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        @* Jeśli karta wolna – przycisk „Przypisz” *@
                                        <form method="post" asp-page-handler="Przypisz" asp-route-id="@karta.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm accent-outline me-1">
                                                Przypisz
                                            </button>
                                        </form>
                                    }

                                    @* Przycisk dezaktywacji *@
                                    <form method="post" asp-page-handler="Dezaktywuj" asp-route-id="@karta.Id" class="d-inline"
                                          onsubmit="return confirm('Czy na pewno chcesz dezaktywować tę kartę?');">
                                        <button type="submit" class="btn btn-sm btn-danger me-1">
                                            Dezaktywuj
                                        </button>
                                    </form>

                                    @* Przycisk aktywacji *@
                                    <form method="post" asp-page-handler="Aktywuj" asp-route-id="@karta.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success me-1">
                                            Aktywuj
                                        </button>
                                    </form>

                                    @* Trwałe usunięcie karty *@
                                    <form method="post" asp-page-handler="Usun" asp-route-id="@karta.Id" class="d-inline"
                                          onsubmit="return confirm('Czy na pewno chcesz trwale usunąć tę kartę z systemu?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Usuń
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Powrót do listy użytkowników *@
        <div class="text-center mt-3">
            <a href="/Uzytkownicy/Lista" class="btn accent-outline">← Powrót</a>
        </div>
    </div>
</body>
</html>
