@page
@model ZamekDoDrzwi.Pages.Uzytkownicy.RFIDModel
@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <title>System Kontroli Dostępu - Przypisywanie RFID</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/site.css" rel="stylesheet" />
</head>
<body>
     @* Główne pudełko logowania / formularza  *@
    <div class="login-box">
         @* Nagłówek formularza *@
        <div class="logo-text">Przypisz kartę RFID</div>

         @* Formularz przypisania karty *@
        <form method="post">
            @* Wybór użytkownika, do którego karta ma zostać przypisana *@
            <div class="mb-3">
                <label class="form-label text-light">Użytkownik</label>
                <select asp-for="WybranyUserId" class="form-control">
                    <option value="">-- Wybierz --</option>
                    @foreach (var u in Model.Uzytkownicy)
                    {
                        <option value="@u.Id">@u.Login</option>
                    }
                </select>
            </div>

             @* UID karty RFID *@
            <div class="mb-3">
                <label class="form-label text-light">Kod RFID (UID)</label>
                <input asp-for="RfidCode" class="form-control" placeholder="np. A1B2C3D4" />
            </div>

            @* Data ważności (może być pusta = bez limitu) *@
            <div class="mb-3">
                <label class="form-label text-light">Ważna do</label>
                <input asp-for="DataWaznosci" type="date" class="form-control" />
            </div>

             @* Opis karty (opcjonalny) *@
            <div class="mb-3">
                <label class="form-label text-light">Opis (opcjonalnie)</label>
                <input asp-for="Opis" class="form-control" placeholder="np. Karta służbowa, brelok" />
            </div>

           @* Przycisk wysyłający formularz *@
            <button type="submit" class="btn btn-primary w-100">Przypisz kartę</button>

            @* Komunikaty błędów / sukcesów *@
            @if (!string.IsNullOrEmpty(Model.BadInfoMessage))
            {
                <div class="error-message mt-3">@Model.BadInfoMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.InfoMessage))
            {
                <div class="success-message mt-3">@Model.InfoMessage</div>
            }
        </form>

        @* Link powrotny do listy użytkowników *@
        <div class="text-center mt-3">
            <a href="/Uzytkownicy/Lista" class="text-info">← Powrót do listy</a>
        </div>
    </div>
</body>
</html>
