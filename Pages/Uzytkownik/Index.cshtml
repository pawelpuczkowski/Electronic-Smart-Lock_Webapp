@page
@model ZamekDoDrzwi.Pages.Uzytkownik.IndexModel
@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Kontroli Dostępu – Dashboard</title>  
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/navbar.css" rel="stylesheet" />
    <link href="~/css/UserDashboard.css" rel="stylesheet" />
</head>
<body>
   
    @await Html.PartialAsync("_UserLayoutNavbar")

    <div class="container py-4">

      @* Sekcja komunikatu tymczasowego (np. po wygenerowaniu kodu) *@
        @if (TempData["msg"] != null)
        {
            <div class="alert alert-info">@TempData["msg"]</div>
        }

        @* SZYBKI STATUS SYSTEMU *@
        <div class="card card-dark mb-4 shadow">
            <div class="card-body">
                <h5 class="text-info mb-3">
                    <i class="bi bi-speedometer2 me-2"></i> Szybki status systemu
                </h5>

                @* Dane podstawowe *@
                <p>Drzwi: <strong>@Model.StatusDrzwi</strong></p>
                <p>Połączenie: <strong>@Model.StatusPolaczenia</strong></p>
                <hr />

                @* Komponenty urządzenia *@
                <p>RFID: <strong>@Model.StatusRFID</strong></p>
                <p>GSM: <strong>@Model.StatusGSM</strong></p>
                <p>Kamera: <strong>@Model.StatusKamera</strong></p>

                @* Czas ostatniej aktualizacji *@
                <p class="small text-muted">
                    Ostatnia aktualizacja: @Model.DataAktualizacji.ToString("yyyy-MM-dd HH:mm:ss")
                </p>
            </div>
        </div>

        @* Układ kart w dwóch kolumnach *@
        <div class="row g-4">

            @* PODGLĄD KAMERY *@
            <div class="col-md-6">
                <div class="card card-dark h-100 shadow">
                    <div class="card-body">
                        <h5 class="mb-3">
                            <i class="bi bi-camera-video me-1"></i> Podgląd kamery
                        </h5>

                        @* Jeśli zdjęcie istnieje *@
                        @if (!string.IsNullOrEmpty(Model.OstatnieZdjecie))
                        {
                            <div class="text-center">
                                <img src="@Model.OstatnieZdjecie"
                                     class="img-fluid rounded border border-secondary shadow-sm"
                                     alt="Ostatnie zdjęcie"
                                     style="max-height: 350px; object-fit: contain;" />
                                <p class="text-muted mt-2 small">
                                    Ostatnie zdjęcie zarejestrowane przez kamerę
                                </p>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mt-3">Brak zdjęcia do wyświetlenia</p>
                        }
                    </div>
                </div>
            </div>

            @* OSTATNIE ZDARZENIA *@
            <div class="col-md-6">
                <div class="card card-dark h-100 shadow">
                    <div class="card-body">
                        <h5>
                            <i class="bi bi-clock-history me-1"></i> Ostatnie zdarzenia
                        </h5>

                        <ul class="list-unstyled mt-3">
                            @if (Model.OstatnieZdarzenia.Any())
                            {
                                foreach (var zd in Model.OstatnieZdarzenia)
                                {
                                    <li class="mb-3 border-bottom border-secondary pb-2">
                                        <div class="text-light">@zd.szczegoly</div>
                                        <div class="text-secondary small">
                                            <i class="bi bi-clock me-1"></i>@zd.czas.ToString("yyyy-MM-dd HH:mm:ss")
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="text-muted">Brak zdarzeń</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            @* KOD TYMCZASOWY *@
                <div class="col-md-6">
                <div class="card card-dark h-100 shadow">
                    <div class="card-body">
                        <h5><i class="bi bi-key me-1"></i> Kod tymczasowy</h5>

                        @* Jeśli istnieje aktywny kod *@
                        @if (!string.IsNullOrEmpty(Model.KodTymczasowy))
                        {
                            <p class="mt-3">
                                <strong class="fs-4">@Model.KodTymczasowy</strong>
                            </p>
                            <p class="muted">
                                Ważny do: @Model.KodWaznyDo?.ToString("yyyy-MM-dd HH:mm:ss")
                            </p>
                        }
                        else
                        {
                            @* Przycisk do wygenerowania nowego kodu *@
                            <form method="post" asp-page-handler="WygenerujKod">
                                <button class="btn accent fw-bold px-4 mt-3" type="submit">Wygeneruj kod</button>
                            </form>
                        }
                    </div>
                </div>
            </div>

            @* OSTATNIE POWIADOMIENIA *@
            <div class="col-md-6">
                <div class="card card-dark h-100 shadow">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-bell-fill me-2"></i> Ostatnie powiadomienia
                        </h5>

                        @* Lista wczytywana dynamicznie przez dashboard-notifications.js *@
                        <ul id="dashNotifList"
                            class="list-group list-group-flush"
                            style="max-height: 280px; overflow:auto;">
                            <div class="text-center text-muted small py-3">Ładowanie...</div>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/dashboard-notifications.js"></script>
</body>
</html>
