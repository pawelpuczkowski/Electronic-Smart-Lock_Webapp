@page
@model ZamekDoDrzwi.Pages.Uzytkownik.Powiadomienia.KonfiguracjaModel
@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Kontroli Dostępu - Konfiguracja kanałów powiadomień</title>    >
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet" />
    <link href="/css/navbar.css" rel="stylesheet" />
</head>
<body>   
    @await Html.PartialAsync("_UserLayoutNavbar")

    <div class="container py-5">
        <div class="card-dark p-4">
            @* Nagłówek sekcji *@
            <h3 class="mb-3">
                <i class="bi bi-bell-fill me-2"></i> Konfiguracja kanałów powiadomień
            </h3>
            <p class="muted mb-4">Wybierz globalne kanały, z których system może korzystać.</p>

            @* Komunikat po zapisie ustawień *@
            @if (!string.IsNullOrEmpty(Model.Komunikat))
            {
                <div class="alert alert-info mb-4">@Model.Komunikat</div>
            }

            @* Formularz zapisu ustawień *@
            <form method="post" class="mt-2">
               @* Włączenie/wyłączenie powiadomień e-mail *@
                <div class="form-check mb-3">
                    <input asp-for="Preferencje.EmailEnabled" class="form-check-input" />
                    <label asp-for="Preferencje.EmailEnabled" class="form-check-label">
                        Powiadomienia e-mail
                    </label>
                </div>

                @* Włączenie/wyłączenie zapisu zdarzeń do logów *@
                <div class="form-check mb-4">
                    <input asp-for="Preferencje.LogEnabled" class="form-check-input" />
                    <label asp-for="Preferencje.LogEnabled" class="form-check-label">
                        Rejestrowanie w logach
                    </label>
                </div>

                @* Przycisk zapisu zmian *@
                <button type="submit" class="btn accent">Zapisz ustawienia</button>
            </form>
        </div>
    </div>
</body>
</html>
