@page
@model ZamekDoDrzwi.Pages.Zamek.OtworzModel
@{
    Layout = null; // Wyłączony globalny layout – korzystamy z własnego (z navbar)
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Kontroli Dostępu - Zdalne otwarcie zamka</title>   
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/css/dashboard.css" rel="stylesheet" />
    <link href="/css/navbar.css" rel="stylesheet" />    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        /* Stylizacja sekcji z informacją o ostatnim otwarciu zamka */
        #ostatnie-otwarcie {
            color: #ccc; /* jaśniejszy szary (czytelny w trybie dark) */
            font-size: 1.1rem;
            margin-top: 2rem;
        }

            #ostatnie-otwarcie b {
                color: #0ff; /* neonowy akcent, spójny z resztą UI */
            }
    </style>
</head>

<body>   
    @await Html.PartialAsync("_LayoutNavbar")

    <div class="container py-5">

        @* Karta główna z przyciskiem otwarcia *@
        <div class="card-dark p-4 text-center shadow-sm">

            <h3 class="mb-3">
                <i class="bi bi-unlock-fill me-2"></i> Zdalne otwarcie zamka
            </h3>
            <p class="muted mb-4">Otwórz zamek z poziomu panelu.</p>

            @* Komunikaty o wyniku akcji *@
            @if (!string.IsNullOrEmpty(Model.KomunikatZamek))
            {
                <div class="alert @(Model.Sukces ? "alert-success" : "alert-danger") mb-4">
                    @Model.KomunikatZamek
                </div>
            }

            @* Formularz otwarcia zamka *@
            <form method="post" class="mb-4">
                <button type="submit" class="btn accent btn-lg"
                        onclick="return confirm('Czy na pewno chcesz otworzyć zamek?');">
                    <i class="bi bi-unlock"></i> Otwórz zamek teraz
                </button>
            </form>
                        
            <div id="loader" class="d-none">
                <div class="spinner-border" style="width: 4rem; height: 4rem; color: var(--accent);" role="status">
                    <span class="visually-hidden">Ładowanie...</span>
                </div>
                <div class="mt-2 muted">Oczekiwanie na otwarcie...</div>
            </div>

            @* Sekcja informacyjna *@
            <p id="ostatnie-otwarcie" class="mt-4">
                Ostatnie zdalne otwarcie: <b>@(Model.OstatnieOtwarcie ?? "brak danych")</b>
            </p>
        </div>
    </div>

    <script>
        const form = document.querySelector("form");
        const loader = document.getElementById("loader");

        form.addEventListener("submit", function () {
            loader.classList.remove("d-none");
        });
    </script>
</body>
</html>
