@page
@model ZamekDoDrzwi.Pages.Zamek.StatusModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Kontroli Dostępu - Status systemu</title>
   
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />   
    <link href="/css/dashboard.css" rel="stylesheet" />
    <link href="/css/navbar.css" rel="stylesheet" />  
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
    @* Pasek nawigacji *@
    @await Html.PartialAsync("_LayoutNavbar")

    <div class="container py-5">
        @* Nagłówek strony *@
        <div class="card-dark p-4 mb-4 shadow-sm">
            <h3 class="mb-2">
                <i class="bi bi-shield-lock-fill me-2" style="color: var(--accent);"></i>
                Status komponentów systemu
            </h3>
            <p class="muted mb-0">
                Bieżący stan modułów oraz czas ostatniej aktualizacji.
            </p>
        </div>

       @* Tabela z danymi o komponentach *@
        <div class="card-dark p-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-bordered align-middle mb-0">
                    <thead class="text-info">
                        <tr>
                            <th>Komponent</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><i class="bi bi-door-closed me-2"></i>Drzwi</td>
                            <td>@Model.StatusDrzwi</td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-plug me-2"></i>Połączenie</td>
                            <td>@Model.StatusPolaczenia</td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-credit-card-2-front me-2"></i>Moduł RFID</td>
                            <td>@Model.StatusRFID</td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-sim me-2"></i>Moduł GSM</td>
                            <td>@Model.StatusGSM</td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-camera-video me-2"></i>Kamera</td>
                            <td>@Model.StatusKamera</td>
                        </tr>
                        <tr>
                            <td><i class="bi bi-clock-history me-2"></i>Data aktualizacji</td>
                            <td>
                                <b>@Model.DataAktualizacji.ToString("yyyy-MM-dd HH:mm:ss")</b>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
